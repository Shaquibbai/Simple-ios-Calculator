<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.calculator_controller"
      styleClass="root-vbox"
      prefWidth="340">

    <!-- DISPLAY -->
    <VBox styleClass="display" VBox.vgrow="ALWAYS">
        <Label fx:id="expressionLabel" styleClass="expression-label"
               maxWidth="Infinity" alignment="CENTER_RIGHT" text=""/>
        <Label fx:id="resultLabel" styleClass="result-label"
               maxWidth="Infinity" alignment="CENTER_RIGHT" text="0"/>
    </VBox>

    <!-- BUTTONS -->
    <GridPane styleClass="button-grid" hgap="12" vgap="12">
        <padding>
            <Insets top="10" right="12" bottom="14" left="12"/>
        </padding>

        <!-- Row 0 -->
        <Button fx:id="backspaceBtn" styleClass="btn-func" onAction="#handleBackspace"
                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button text="AC" styleClass="btn-func" onAction="#handleAC"
                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button fx:id="percentBtn" styleClass="btn-func" onAction="#handlePercent"
                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Button fx:id="divideBtn" styleClass="btn-operator" onAction="#handleOperator"
                GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <!-- Row 1 -->
        <Button text="7" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button text="8" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button text="9" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Button fx:id="multiplyBtn" styleClass="btn-operator" onAction="#handleOperator"
                GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <!-- Row 2 -->
        <Button text="4" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button text="5" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button text="6" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Button fx:id="subtractBtn" styleClass="btn-operator" onAction="#handleOperator"
                GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <!-- Row 3 -->
        <Button text="1" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button text="2" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button text="3" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <Button text="+" styleClass="btn-operator" onAction="#handleOperator"
                GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        <!-- Row 4 -->
        <Button fx:id="negateBtn" styleClass="btn-func" onAction="#handleNegate"
                GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Button text="0" styleClass="btn-number" onAction="#handleNumber"
                GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Button text="." styleClass="btn-number" onAction="#handleDecimal"
                GridPane.columnIndex="2" GridPane.rowIndex="4"/>
        <Button text="=" styleClass="btn-operator" onAction="#handleEquals"
                GridPane.columnIndex="3" GridPane.rowIndex="4"/>
    </GridPane>

</VBox>